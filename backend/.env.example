# Backend environment example
# Copy this file to .env and fill in real values

# PostgreSQL connection string (Render provides DATABASE_URL)
# Example: postgres://user:password@hostname:5432/database
DATABASE_URL=postgres://username:password@localhost:5432/m3_ride
DATABASE_SSL=false
DB_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost

# Secret used to sign JWT tokens – keep it safe!
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional first administrator, created/updated by npm run migrate
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
